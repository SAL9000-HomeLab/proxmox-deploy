---
# Used by CI (shared ansible-ci workflow) and by ansible-lint's yaml rules.
extends: default

ignore: |
  .venv/
  local/

rules:
  # Matches the 120-column ruler in .vscode/settings.json.
  line-length:
    max: 120
  # GitHub workflows use `on:` as a key.
  truthy:
    check-keys: false
  # Settings ansible-lint requires to stay compatible with its own yaml rules.
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
