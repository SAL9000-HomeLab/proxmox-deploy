#cloud-config
hostname: {{ vm_item.hostname | default(vm_item.name) }}
fqdn: {{ vm_item.hostname | default(vm_item.name) }}
manage_etc_hosts: true

timezone: UTC

ssh_pwauth: false

# The template's build account is locked with no key; this makes it (or a
# new user, if linux_admin_user is changed) the key-only admin login.
users:
  - name: {{ linux_admin_user | default('ansible') | to_json }}
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
{% for key in linux_admin_keys_resolved %}
      - {{ key | to_json }}
{% endfor %}

package_update: true
packages:
  - qemu-guest-agent

runcmd:
  - systemctl enable qemu-guest-agent
  - systemctl start qemu-guest-agent

{% if vm_item.dns_servers is defined or vm_item.dns is defined %}
write_files:
  - path: /etc/resolv.conf
    content: |
      {% if vm_item.dns_servers is defined %}
      {% for ns in vm_item.dns_servers %}
      nameserver {{ ns }}
      {% endfor %}
      {% else %}
      nameserver {{ vm_item.dns }}
      {% endif %}
      {% if vm_item.search_domains is defined %}
      search {{ vm_item.search_domains | join(' ') }}
      {% endif %}
{% endif %}
