#cloud-config
# Cloudbase-Init user-data for Windows
# Rendered for: {{ vm_name }} (vmid {{ desired_vmid }})

{% set _hostname = (vm_item.hostname if vm_item.hostname is defined and vm_item.hostname else (vm_name | default('winvm'))) %}
set_hostname: "{{ _hostname }}"

{% if vm_item.timezone is defined and vm_item.timezone %}
set_timezone: "{{ vm_item.timezone }}"
{% endif %}

{# Optional local groups to create / populate #}
{% if vm_item.local_groups is defined and vm_item.local_groups %}
groups:
{% for gname, members in vm_item.local_groups.items() -%}
  - {{ gname }}: [{% for m in members %}{{ m }}{% if not loop.last %}, {% endif %}{% endfor %}]
{% endfor %}
{% endif %}

